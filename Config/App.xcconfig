// Public defaults make a clean checkout buildable without a developer account.
SLIPSTREAM_BUNDLE_ID = com.example.Slipstream
SLIPSTREAM_KEYCHAIN_SERVICE = $(SLIPSTREAM_BUNDLE_ID).session
SLIPSTREAM_DEVELOPMENT_IDENTITY = Apple Development
SLIPSTREAM_CODE_SIGN_STYLE = Automatic

// Personal identifiers and signing configuration belong only in this ignored file.
#include? "Local.xcconfig"
