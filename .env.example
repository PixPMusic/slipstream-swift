# Optional, trusted shell configuration for the scripts. Copy to .env.local.
# Xcode itself uses Config/Local.xcconfig instead.
# Exported environment variables override .env.local values.

# SLIPSTREAM_BUNDLE_ID=com.yourcompany.Slipstream
# APPLE_TEAM_ID=YOUR_TEAM_ID
# APPLE_SIGNING_IDENTITY='Apple Development: Your Name (CERTIFICATE_ID)'
# SLIPSTREAM_KEYCHAIN_SERVICE=com.yourcompany.Slipstream.session
# APP_VERSION=0.1.0
# BUILD_NUMBER=2

# App Store Connect API authentication is optional when Xcode is signed in.
# Store the private key outside the repository; never paste it into this file.
# APP_STORE_CONNECT_KEY_PATH=/private/path/AuthKey.p8
# APP_STORE_CONNECT_KEY_ID=YOUR_KEY_ID
# APP_STORE_CONNECT_ISSUER_ID=YOUR_ISSUER_ID
